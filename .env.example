# Optional. The desktop app stays on local drafts until Settings switches to OpenAI-compatible.
# Ollama on this machine (key can stay empty):
# VITE_OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# VITE_OPENAI_MODEL=qwen2.5:7b
# VITE_OPENAI_API_KEY=
# Any other OpenAI-compatible /v1/chat/completions endpoint uses the same three variables.
# Keys typed in the desktop app stay on this computer.
VITE_OPENAI_API_KEY=
VITE_OPENAI_BASE_URL=https://api.openai.com/v1
VITE_OPENAI_MODEL=gpt-4o-mini
