# First-launch defaults only. Change them later in the app: 设置 → 大模型.
# 接口地址, API Key, and 模型名 typed there stay on this device.
# Replies go to this OpenAI-compatible endpoint, with the current WeChat chat as context.
# The app default is Ollama on this machine. A key stays empty unless the endpoint asks for one.
VITE_OPENAI_BASE_URL=http://127.0.0.1:11434/v1
VITE_OPENAI_MODEL=qwen2.5:7b
VITE_OPENAI_API_KEY=
