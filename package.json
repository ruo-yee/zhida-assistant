{
  "name": "zhida-assistant",
  "private": true,
  "version": "0.1.0",
  "description": "贴在微信右侧的本地知识检索与回复助手",
  "author": "智答助手",
  "desktopName": "zhida-assistant.desktop",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n web,shell \"vite --host 127.0.0.1 --port 43123 --strictPort\" \"wait-on http-get://127.0.0.1:43123 && npm run build:electron && electron . --dev\"",
    "dev:web": "vite --host 127.0.0.1 --port 43123 --strictPort",
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --format=cjs --outfile=dist-electron/main.cjs --external:electron && esbuild electron/preload.ts --bundle --platform=node --format=cjs --outfile=dist-electron/preload.cjs --external:electron",
    "build": "tsc -b && vite build",
    "start": "npm run build && npm run build:electron && electron .",
    "dist": "npm run build && npm run build:electron && electron-builder --linux --win --publish never",
    "dist:win": "npm run build && npm run build:electron && electron-builder --win --publish never",
    "dist:mac": "bash packaging/build_mac.sh",
    "sign:mac-identity": "bash packaging/make_local_signing.sh",
    "dist:linux": "npm run build && npm run build:electron && electron-builder --linux --publish never",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.6",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "fzstd": "^0.1.1",
    "lucide-react": "^1.56.0",
    "oxlint": "^1.81.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.4",
    "wait-on": "^9.5.1"
  }
}
